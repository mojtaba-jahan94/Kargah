# ========================================================
# متغیرهای محیطی پروژه کارگاه (Kargah) برای اتصال به Turso در Vercel
# ========================================================

# ۱. آدرس دیتابیس Turso (از طریق دستور turso db show <db-name> یا پنل کاربری turso.tech)
# مثال: libsql://my-kargah-db-yourname.turso.io
TURSO_DATABASE_URL=

# ۲. توکن احراز هویت Turso (از طریق دستور turso db tokens create <db-name>)
TURSO_AUTH_TOKEN=

# ۳. کلید رمزنگاری نشست‌های ورود JWT (یک رشته تصادفی و امن)
JWT_SECRET=kargah_super_secret_jwt_key_2026_xyz
